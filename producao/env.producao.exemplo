# .env de PRODUCAO do Bom Bocado (modelo, sem valores).
# Copie para C:\Receitas-producao\segredos\.env e preencha os campos vazios.
# Nunca commite o arquivo preenchido.

APP_NAME="Bom Bocado"
APP_ENV=production
# Chave de criptografia do Laravel. Fica vazia: o "publicar.ps1 -Primeira" gera e grava sozinho.
APP_KEY=
APP_DEBUG=false
# Endereço público (Tailscale Funnel). Com https, os links do app saem em https.
APP_URL=https://vps-claude.tail263835.ts.net
# Vazio: na produção o app fica na raiz do endereço (o /receitas é só do Docker de testes).
ASSET_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=banco
DB_PORT=3306
DB_DATABASE=receitas
DB_USERNAME=root
# A mesma senha de BANCO_SENHA_ROOT em segredos\compose.env.
DB_PASSWORD=

SESSION_DRIVER=database
# Sessão longa (1 ano, em minutos) para o Compartilhar funcionar sem pedir login toda vez (design 5.1).
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie só por HTTPS (o Funnel sempre usa HTTPS).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail (Fase 3, passo 19): conta Gmail do app com "senha de app".
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# E-mail da conta Gmail do app.
MAIL_USERNAME=
# Senha de app do Gmail (16 letras), gerada em myaccount.google.com > Segurança > Senhas de app.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Bom Bocado"

# Chave da API da Anthropic (Fase 7). A mesma do .env da raiz do projeto (vence em 01/07/2027).
ANTHROPIC_API_KEY=

VITE_APP_NAME="Bom Bocado"
